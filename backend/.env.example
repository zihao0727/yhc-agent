DATABASE_URL=postgresql+psycopg://firefly_pricing_app:CHANGE_ME@127.0.0.1:5432/firefly_pricing
ADMIN_TOKEN=CHANGE_ME
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
SILICONFLOW_TIMEOUT=60
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=firefly:agent
AGENT_BACKGROUND=true
AGENT_RETRY_SECONDS=30
AGENT_MAX_RETRIES=5
# 0 disables cumulative token-based pauses; usage is still recorded.
AGENT_MAX_TOTAL_TOKENS=0
# Idle rounds trigger a notice, not a pause.
AGENT_MAX_IDLE_ROUNDS=30
AGENT_STALL_ROUNDS=12
AGENT_SLICE_ROUNDS=6
AGENT_SLICE_SECONDS=90
# Same-category estimated rate variation triggers review, not a market-price cap.
QUOTE_ANOMALY_RATIO=4

DATABASE_URL=postgresql+psycopg://firefly_pricing_app:CHANGE_ME@127.0.0.1:5432/firefly_pricing
ADMIN_TOKEN=CHANGE_ME
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
SILICONFLOW_TIMEOUT=60
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=firefly:agent
AGENT_BACKGROUND=true
# external: launch python -m app.agent_worker separately; embedded preserves local compatibility.
AGENT_WORKER_MODE=embedded
AGENT_DEPENDENCY_CHECK_SECONDS=30
AGENT_WORKER_STALL_SECONDS=600
# Independent pricing requests only; 1 restores sequential processing.
AGENT_PRICING_CONCURRENCY=4
AGENT_RETRY_SECONDS=30
AGENT_MAX_RETRIES=5
# 0 disables cumulative token-based pauses; usage is still recorded.
AGENT_MAX_TOTAL_TOKENS=0
# 0 also disables the independent per-item token cap.
AGENT_LINE_MAX_TOKENS=0
AGENT_COMPACT_PLANS=true
AGENT_RESPONSE_MAX_TOKENS=10000
# Idle rounds trigger a notice, not a pause.
AGENT_MAX_IDLE_ROUNDS=30
AGENT_STALL_ROUNDS=12
AGENT_SLICE_ROUNDS=6
AGENT_SLICE_SECONDS=90
MAX_PDF_UPLOAD_BYTES=209715200
MAX_JOB_UPLOAD_BYTES=524288000
MAX_JOB_PAGES=500
MAX_REQUIREMENT_LINES=10000
PDF_RENDER_BATCH_PAGES=4
PDF_REGION_ROWS=2
PDF_REGION_COLUMNS=1
PDF_MAX_REGION_DEPTH=3
# Independent visual inventory and bounded re-reading of suspected omissions.
VISUAL_REGION_AUDIT=true
IMAGE_TILE_PIXELS=1600
EXTRACTION_SLICE_BATCHES=8
EXTRACTION_RECOVERY_ROUNDS=8
# AI reads originals, revises observations and reviews coverage before pricing.
SOURCE_AGENT_ENABLED=true
# Per continuation budget; 0 disables the token cap. Explicit resume grants a new budget.
SOURCE_AGENT_MAX_TOKENS=3000000
SOURCE_AGENT_MAX_TURNS=1600
# Soft text window; new source data is never silently truncated to meet this target.
SOURCE_AGENT_CONTEXT_CHARS=48000
# Explicit Excel row facts use local parsing; ambiguous pages still use the model.
EXCEL_NATIVE_FIRST=true
# Same-category estimated rate variation triggers review, not a market-price cap.
QUOTE_ANOMALY_RATIO=4
FILE_WORKSPACE_ENABLED=true
FILE_WORKSPACE_IMAGE=firefly-file-worker:1
FILE_WORKSPACE_TIMEOUT=45
FILE_WORKSPACE_MEMORY_MB=512
# Runtime tool repairs use the current schema, transactional replay and verified hints.
AGENT_RUNTIME_RECOVERY=true
AGENT_RUNTIME_REPAIR_ATTEMPTS=3
